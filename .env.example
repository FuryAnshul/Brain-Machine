# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# SECURITY DIRECTIVE:
# 1. Never commit `.env.local` containing actual credentials to source control.
# 2. Never prefix server-side secrets or webhook endpoints with `NEXT_PUBLIC_`,
#    as Next.js will inline them into client-side JavaScript bundles.
# =============================================================================

# Google Sheets 2-Way Live Sync (Server-Side Endpoint)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec

# Administrator Security Recovery Key (Server-Side Verification)
ADMIN_RECOVERY_KEY=your-secure-admin-recovery-key-here

# Temporary Admin Test Account (Isolated Dev / Staging only; disabled in production by default)
# ALLOW_TEMP_ADMIN=true

